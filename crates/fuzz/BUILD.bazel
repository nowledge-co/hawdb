load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_HAWDB_FUZZ_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "vector-search",
]

rust_library(
    name = "hawdb_fuzz",
    crate_name = "hawdb_fuzz",
    crate_root = "src/lib.rs",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/append_main.rs",
            "src/main.rs",
            "src/parser_main.rs",
            "src/storage_main.rs",
        ],
    ),
    edition = "2024",
    aliases = aliases(),
    crate_features = _HAWDB_FUZZ_DEFAULT_FEATURES,
    deps = all_crate_deps(normal = True) + [
        "//:hawdb",
        "//crates/fuzz-contracts:hawdb_fuzz_contracts",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

_APPEND_STATE_MACHINE_SEED_7_TEST = "append_oracle::tests::append_state_machine_matches_reference_model_across_reopen"
_APPEND_STATE_MACHINE_REPLAY_TEST = "append_oracle::tests::append_state_machine_is_replayable_for_another_seed"
_RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST = "sql_oracle::tests::relational_join_rewrite_differential_campaign_covers_every_shape"

rust_test(
    name = "hawdb_fuzz_fast_tests",
    args = [
        "--skip",
        _APPEND_STATE_MACHINE_SEED_7_TEST,
        "--skip",
        _APPEND_STATE_MACHINE_REPLAY_TEST,
        "--skip",
        _RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST,
    ],
    crate = ":hawdb_fuzz",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate_features = _HAWDB_FUZZ_DEFAULT_FEATURES,
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

[
    rust_test(
        name = name,
        size = "large",
        args = [
            test_filter,
            "--exact",
        ],
        crate = ":hawdb_fuzz",
        edition = "2024",
        aliases = aliases(normal_dev = True, proc_macro_dev = True),
        crate_features = _HAWDB_FUZZ_DEFAULT_FEATURES,
        deps = all_crate_deps(normal_dev = True),
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    )
    for name, test_filter in [
        ("hawdb_fuzz_append_seed_7_tests", _APPEND_STATE_MACHINE_SEED_7_TEST),
        ("hawdb_fuzz_append_replay_tests", _APPEND_STATE_MACHINE_REPLAY_TEST),
        ("hawdb_fuzz_relational_join_rewrite_tests", _RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST),
    ]
]

