load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_SKEIN_FUZZ_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "vector-search",
]

rust_library(
    name = "skein_fuzz",
    crate_name = "skein_fuzz",
    crate_root = "src/lib.rs",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/append_main.rs",
            "src/main.rs",
            "src/parser_main.rs",
            "src/storage_main.rs",
        ],
    ),
    edition = "2024",
    aliases = aliases(),
    crate_features = _SKEIN_FUZZ_DEFAULT_FEATURES,
    deps = all_crate_deps(normal = True) + ["//:skein"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

_APPEND_STATE_MACHINE_SEED_7_TEST = "append_oracle::tests::append_state_machine_matches_reference_model_across_reopen"
_APPEND_STATE_MACHINE_REPLAY_TEST = "append_oracle::tests::append_state_machine_is_replayable_for_another_seed"
_RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST = "sql_oracle::tests::relational_join_rewrite_differential_campaign_covers_every_shape"

rust_test(
    name = "skein_fuzz_fast_tests",
    args = [
        "--skip",
        _APPEND_STATE_MACHINE_SEED_7_TEST,
        "--skip",
        _APPEND_STATE_MACHINE_REPLAY_TEST,
        "--skip",
        _RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST,
    ],
    crate = ":skein_fuzz",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate_features = _SKEIN_FUZZ_DEFAULT_FEATURES,
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

[
    rust_test(
        name = name,
        size = "large",
        args = [
            test_filter,
            "--exact",
        ],
        crate = ":skein_fuzz",
        edition = "2024",
        aliases = aliases(normal_dev = True, proc_macro_dev = True),
        crate_features = _SKEIN_FUZZ_DEFAULT_FEATURES,
        deps = all_crate_deps(normal_dev = True),
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    )
    for name, test_filter in [
        ("skein_fuzz_append_seed_7_tests", _APPEND_STATE_MACHINE_SEED_7_TEST),
        ("skein_fuzz_append_replay_tests", _APPEND_STATE_MACHINE_REPLAY_TEST),
        ("skein_fuzz_relational_join_rewrite_tests", _RELATIONAL_JOIN_REWRITE_DIFFERENTIAL_TEST),
    ]
]

test_suite(
    name = "skein_fuzz_tests",
    tests = [
        ":skein_fuzz_append_replay_tests",
        ":skein_fuzz_append_seed_7_tests",
        ":skein_fuzz_fast_tests",
        ":skein_fuzz_relational_join_rewrite_tests",
        ":skein_append_fuzz_cli_tests",
        ":skein_parser_fuzz_cli_tests",
        ":skein_storage_fuzz_tests",
        "//crates/optimizer:skein_optimizer_candidate_fingerprint_fuzz_tests",
        "//crates/optimizer:skein_optimizer_full_text_cost_fuzz_tests",
        "//crates/optimizer:skein_optimizer_trace_cost_fuzz_tests",
    ],
)

rust_binary(
    name = "skein_storage_fuzz",
    crate_root = "src/storage_main.rs",
    srcs = ["src/storage_main.rs"],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        ":skein_fuzz",
        "//:skein",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

