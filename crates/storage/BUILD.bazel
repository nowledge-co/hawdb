load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "skein_storage",
    crate_name = "skein_storage",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:skein_core",
        "//crates/integrity:skein_integrity",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_storage_tests",
    crate = ":skein_storage",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_storage_sharded_cache_fuzz_tests",
    args = [
        "cache::shard_tests::sharded_cache_state_machine_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_storage",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_storage_file_lock_fuzz_tests",
    args = [
        "publication_lock_state_machine_campaign",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_storage",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_storage_verified_page_cache_fuzz_tests",
    args = [
        "index_page::verified_cache_tests::verified_page_cache_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_storage",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_storage_positioned_read_fuzz_tests",
    args = [
        "io::tests::positioned_read_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_storage",
    edition = "2024",
