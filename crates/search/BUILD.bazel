load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_SEARCH_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "vector-search",
]

_SEARCH_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:skein_core",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/integrity:skein_integrity",
    "//crates/optimizer:skein_optimizer",
    "//crates/plan:skein_plan",
    "//crates/qos:skein_qos",
    "//crates/storage:skein_storage",
    "//crates/telemetry:skein_telemetry",
    "//crates/vector-projection:skein_vector_projection",
]

rust_library(
    name = "skein_search",
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_search_tests",
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Exercise private production codecs without exposing a fuzz-only library API.
# Ignored Rust tests and manual labels keep campaigns out of ordinary CI tests.
[
    rust_test(
        name = "skein_search_lexical_%s_fuzz_tests" % campaign,
        size = "large",
        tags = ["manual"],
        args = [
            "lexical_projection::tests::fuzz::%s" % test_filter,
            "--exact",
            "--ignored",
            "--nocapture",
        ],
        crate = ":skein_search",
        crate_features = _SEARCH_DEFAULT_FEATURES,
        edition = "2024",
        aliases = aliases(normal_dev = True, proc_macro_dev = True),
        deps = all_crate_deps(normal_dev = True),
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    )
    for campaign, test_filter in [
        ("analyzer", "analysis::frequency_parity_campaign"),
        ("artifact", "artifact::document_mapping_admission_campaign"),
        ("merge", "merge::merge_admission_campaign"),
        ("query_memory", "query_memory::query_memory_campaign"),
        ("posting", "bytes::posting_bytes_campaign"),
        ("dictionary", "bytes::dictionary_bytes_campaign"),
        ("dictionary_memory", "dictionary_memory::dictionary_admission_campaign"),
        ("doclist", "bytes::doclist_bytes_campaign"),
        ("state_machine", "state_machine::projection_state_machine_campaign"),
    ]
]

