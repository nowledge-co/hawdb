load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

_SEARCH_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "vector-search",
]

_SEARCH_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:skein_core",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/integrity:skein_integrity",
    "//crates/optimizer:skein_optimizer",
    "//crates/plan:skein_plan",
    "//crates/qos:skein_qos",
    "//crates/storage:skein_storage",
    "//crates/telemetry:skein_telemetry",
    "//crates/vector-projection:skein_vector_projection",
]

rust_library(
    name = "skein_search",
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Match Cargo's explicit `skein-search/acl` forwarding without enabling ACL
# for the default library or introducing a production integration target.
rust_library(
    name = "skein_search_acl",
    testonly = True,
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    crate_features = _SEARCH_DEFAULT_FEATURES + ["acl"],
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "skein_search_tests",
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_search_hex_decoding_fuzz_tests",
    args = [
        "document_decoding_tests::hex_decoding_differential_campaign",
        "--exact",
        "--ignored",
    ],
    tags = ["manual"],
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_search_compression_fuzz_tests",
    args = [
        "compression_tests::compressed_envelope_differential_campaign",
        "--exact",
        "--ignored",
    ],
    tags = ["manual"],
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_search_lexical_spill_fuzz_tests",
    args = [
        "lexical_projection::spill_tests::fuzz::lexical_spill_admission_differential_campaign",
        "--exact",
        "--ignored",
    ],
    tags = ["manual"],
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Keep the seeded analyzer campaign on the explicit local fuzz surface.
rust_test(
    name = "skein_search_document_analysis_fuzz_tests",
    tags = ["manual"],
    args = [
        "lexical_projection::analysis_tests::document_analysis_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Keep spool encoding faults and differential coverage on the local fuzz surface.
rust_test(
    name = "skein_search_spool_encoding_fuzz_tests",
    tags = ["manual"],
    args = [
        "out_of_core::generation_writer::spool::write_tests::spool_encoding_differential_campaign",
        "--exact",
        "--ignored",
    ],
    crate = ":skein_search",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Keep optional-capability contracts executable without enabling every feature.
[
    rust_test(
        name = "skein_search_%s_tests" % profile,
        crate_name = "skein_search",
        crate_root = "src/lib.rs",
        crate_features = features,
        srcs = glob(["src/**/*.rs"]),
        edition = "2024",
        aliases = aliases(
            normal = True,
            normal_dev = True,
            proc_macro = True,
            proc_macro_dev = True,
        ),
        deps = _SEARCH_DEPS + all_crate_deps(normal_dev = True),
        proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    )
    for profile, features in {
        "acl": _SEARCH_DEFAULT_FEATURES + ["acl"],
        "minimal": [],
        "text_only": ["full-text-search"],
        "vector_only": ["vector-search"],
        "background_only": ["background-maintenance"],
        "text_vector": ["full-text-search", "vector-search"],
        "text_background": ["full-text-search", "background-maintenance"],
        "vector_background": ["vector-search", "background-maintenance"],
    }.items()
]
