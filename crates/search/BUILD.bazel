load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "candidate_probe_test_fixtures",
    srcs = ["src/candidate_evidence/tests/probe_fixtures.rs"],
    visibility = ["//:__pkg__"],
)

test_suite(
    name = "presubmit_tests",
)

_SEARCH_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "vector-search",
]

_SEARCH_BASE_DEPS = [
    "@crate_index//:chrono",
    "@crate_index//:jieba-rs",
    "@crate_index//:regex",
    "@crate_index//:regex-automata",
    "@crate_index//:regex-syntax",
    "@crate_index//:serde",
    "@crate_index//:serde_json",
    "@crate_index//:zstd",
    "//crates/core:skein_core",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/integrity:skein_integrity",
    "//crates/optimizer:skein_optimizer",
    "//crates/plan:skein_plan",
    "//crates/qos:skein_qos",
    "//crates/storage:skein_storage",
    "//crates/telemetry:skein_telemetry",
]

_SEARCH_VECTOR_DEPS = [
    "@crate_index//:simsimd",
    "//crates/vector-projection:skein_vector_projection",
]

_SEARCH_DEPS = _SEARCH_BASE_DEPS + _SEARCH_VECTOR_DEPS

rust_library(
    name = "skein_search",
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    crate_features = _SEARCH_DEFAULT_FEATURES,
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Matches `skein-search = { default-features = false }` for embedded hosts
# that own another native vector provider in the same process.
rust_library(
    name = "skein_search_minimal",
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_BASE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//:__pkg__",
        "//crates/bootstrap:__pkg__",
        "//crates/nowledge-contracts:__pkg__",
    ],
)

# Match Cargo's explicit `skein-search/acl` forwarding without enabling ACL
# for the default library or introducing a production integration target.
rust_library(
    name = "skein_search_acl",
    testonly = True,
    crate_name = "skein_search",
    crate_root = "src/lib.rs",
    crate_features = _SEARCH_DEFAULT_FEATURES + ["acl"],
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _SEARCH_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = [
        "//:__pkg__",
        "//crates/bootstrap:__pkg__",
        "//crates/nowledge-contracts:__pkg__",
    ],
)

