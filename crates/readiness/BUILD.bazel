load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_READINESS_TEST_DATA = glob(["src/**/*.json", "src/**/*.jsonl"])
_READINESS_TEST_DEPS = all_crate_deps(normal_dev = True) + [
    "//crates/search:skein_search",
]

_READINESS_BASE_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:skein_core",
    "//crates/cypher:skein_cypher",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/plan-cache:skein_plan_cache",
    "//crates/route-ownership:skein_route_ownership",
    "//crates/storage:skein_storage",
]

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "skein_readiness",
    crate_name = "skein_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/search:skein_search",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Match the root facade's no-default-features graph so public runtime-status
# contracts are never linked to a second skein-search instance.
rust_library(
    name = "skein_readiness_minimal",
    crate_name = "skein_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/search:skein_search_minimal",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

# Match the ACL qualification graph without enabling ACL for the default crate.
rust_library(
    name = "skein_readiness_acl",
    testonly = True,
    crate_name = "skein_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/search:skein_search_acl",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "skein_replacement_summary_fuzz_tests",
    tags = ["manual"],
    args = [
        "replacement_summary::tests::differential::replacement_summary_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = _READINESS_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

