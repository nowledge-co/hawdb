load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_READINESS_TEST_DATA = glob(["src/**/*.json", "src/**/*.jsonl"])
_READINESS_TEST_DEPS = all_crate_deps(normal_dev = True) + [
    "//crates/search:hawdb_search",
]

_READINESS_BASE_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:hawdb_core",
    "//crates/cypher:hawdb_cypher",
    "//crates/evidence:hawdb_evidence",
    "//crates/executor:hawdb_executor",
    "//crates/plan-cache:hawdb_plan_cache",
    "//crates/route-ownership:hawdb_route_ownership",
    "//crates/system-sql:hawdb_system_sql",
    "//crates/storage:hawdb_storage",
]

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_readiness",
    crate_name = "hawdb_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/nowledge-contracts:hawdb_nowledge_contracts",
        "//crates/search:hawdb_search",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Matches the root facade's no-default-features graph so public contracts are
# never linked from a second dependency feature variant.
rust_library(
    name = "hawdb_readiness_minimal",
    crate_name = "hawdb_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/nowledge-contracts:hawdb_nowledge_contracts_minimal",
        "//crates/search:hawdb_search_minimal",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

# Matches the ACL qualification graph without enabling ACL for the default crate.
rust_library(
    name = "hawdb_readiness_acl",
    testonly = True,
    crate_name = "hawdb_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _READINESS_BASE_DEPS + [
        "//crates/nowledge-contracts:hawdb_nowledge_contracts_acl",
        "//crates/search:hawdb_search_acl",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "hawdb_replacement_summary_fuzz_tests",
    tags = ["manual"],
    args = [
        "replacement_summary::tests::differential::replacement_summary_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = _READINESS_TEST_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

