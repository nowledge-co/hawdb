load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_READINESS_TEST_DATA = glob(["src/**/*.json", "src/**/*.jsonl"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "skein_readiness",
    crate_name = "skein_readiness",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:skein_core",
        "//crates/evidence:skein_evidence",
        "//crates/route-ownership:skein_route_ownership",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_source_mutation_readiness_fuzz_tests",
    tags = ["manual"],
    args = [
        "source_mutation::differential::source_mutation_readiness_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_readiness_tests",
    crate = ":skein_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_graph_route_readiness_fuzz_tests",
    tags = ["manual"],
    args = [
        "graph_route::differential::graph_route_readiness_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_integration_bundle_fuzz_tests",
    tags = ["manual"],
    args = [
        "integration_bundle::tests::integration_bundle_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_readiness",
    compile_data = _READINESS_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
