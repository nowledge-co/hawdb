load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_sql",
    crate_name = "hawdb_sql",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:hawdb_core",
        "//crates/expression:hawdb_expression",
        "//crates/plan:hawdb_plan",
        "//crates/plan-cache:hawdb_plan_cache",
        "//crates/sql-syntax:hawdb_sql_syntax",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

_SQL_TEST_DATA = glob(["fixtures/frontend_*"]) + [
    "//crates/qualification:sql_frontend_corpus_inputs",
    "//crates/sql-syntax:frontend_corpus_sources",
]

rust_test(
    name = "hawdb_sql_tests",
    crate = ":hawdb_sql",
    compile_data = _SQL_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# This campaign runs only when explicitly selected for local fuzz verification.
rust_test(
    name = "hawdb_sql_clause_diagnostics_fuzz_tests",
    tags = ["manual"],
    args = [
        "parser::clause_tests::clause_diagnostics_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_sql",
    compile_data = _SQL_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "hawdb_sql_frontend_corpus_fuzz_tests",
    tags = ["manual"],
    args = [
        "tests::frontend_corpus::frontend_corpus_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_sql",
    compile_data = _SQL_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "hawdb_sql_create_binding_fuzz_tests",
    tags = ["manual"],
    args = [
        "pgq::create::tests::create_binding_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_sql",
    compile_data = _SQL_TEST_DATA,
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
