load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "skein_sql",
    crate_name = "skein_sql",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:skein_core",
        "//crates/plan:skein_plan",
        "//crates/plan-cache:skein_plan_cache",
        "//crates/sql-syntax:skein_sql_syntax",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_sql_tests",
    crate = ":skein_sql",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# This campaign runs only when explicitly selected for local fuzz verification.
rust_test(
    name = "skein_sql_clause_diagnostics_fuzz_tests",
    tags = ["manual"],
    args = [
        "parser::clause_tests::clause_diagnostics_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_sql",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
