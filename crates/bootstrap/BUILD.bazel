load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

_BOOTSTRAP_BASE_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:hawdb_core",
    "//crates/integrity:hawdb_integrity",
    "//crates/storage:hawdb_storage",
]

rust_library(
    name = "hawdb_bootstrap",
    crate_name = "hawdb_bootstrap",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _BOOTSTRAP_BASE_DEPS + ["//crates/search:hawdb_search"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Matches the root facade's `--no-default-features` boundary without linking a
# second copy of `hawdb_search` with incompatible Bazel feature selection.
rust_library(
    name = "hawdb_bootstrap_minimal",
    crate_name = "hawdb_bootstrap",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _BOOTSTRAP_BASE_DEPS + ["//crates/search:hawdb_search_minimal"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

# Matches Cargo feature unification for the root ACL qualification target
# without linking a second `hawdb_search` crate with a different feature set.
rust_library(
    name = "hawdb_bootstrap_acl",
    testonly = True,
    crate_name = "hawdb_bootstrap",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = _BOOTSTRAP_BASE_DEPS + ["//crates/search:hawdb_search_acl"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "hawdb_bootstrap_tests",
    crate = ":hawdb_bootstrap",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
