load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_test(
    name = "hawdb_relational_physical_plan_fuzz_tests",
    args = [
        "physical_plan::tests::physical_plan_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    tags = ["manual"],
    crate = ":hawdb_relational",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_library(
    name = "hawdb_relational",
    crate_name = "hawdb_relational",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:hawdb_core",
        "//crates/executor:hawdb_executor",
        "//crates/sql:hawdb_sql",
        "//crates/expression:hawdb_expression",
        "//crates/integrity:hawdb_integrity",
        "//crates/optimizer:hawdb_optimizer",
        "//crates/plan:hawdb_plan",
        "//crates/storage:hawdb_storage",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

