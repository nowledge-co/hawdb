load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
    tests = [
        ":hawdb_optimizer_tests",
        "//crates/optimizer-graph:presubmit_tests",
        "//crates/optimizer-relational:presubmit_tests",
        "//crates/optimizer-predicate:presubmit_tests",
        "//crates/optimizer-vector:presubmit_tests",
    ],
)

rust_library(
    name = "hawdb_optimizer",
    crate_name = "hawdb_optimizer",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/cascades:hawdb_cascades",
        "//crates/optimizer-graph:hawdb_optimizer_graph",
        "//crates/optimizer-relational:hawdb_optimizer_relational",
        "//crates/optimizer-predicate:hawdb_optimizer_predicate",
        "//crates/optimizer-vector:hawdb_optimizer_vector",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "hawdb_optimizer_tests",
    crate = ":hawdb_optimizer",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Preserve the existing local campaign and golden labels across ownership moves.
# Forward tests through suites so Bazel runs both direct and aggregate labels.
test_suite(
    name = "hawdb_optimizer_cardinality_metadata_fuzz_tests",
