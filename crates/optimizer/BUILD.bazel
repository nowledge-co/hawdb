load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_optimizer",
    crate_name = "hawdb_optimizer",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:hawdb_core",
        "//crates/cypher:hawdb_cypher",
        "//crates/expression:hawdb_expression",
        "//crates/plan:hawdb_plan",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "hawdb_optimizer_tests",
    crate = ":hawdb_optimizer",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "planner_golden_test",
    srcs = ["tests/planner_golden.rs"],
    crate_root = "tests/planner_golden.rs",
    compile_data = [
        "tests/golden/filtered_vector_pipeline.golden",
        "tests/golden/indexed_memory_lookup.golden",
    ],
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        ":hawdb_optimizer",
        "//crates/cypher:hawdb_cypher",
        "//crates/plan:hawdb_plan",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Private production costing, exercised only by an explicitly selected campaign.
rust_test(
    name = "hawdb_optimizer_cardinality_metadata_fuzz_tests",
    tags = ["manual"],
    args = [
        "graph::cardinality::bindings::tests::cardinality_metadata_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_optimizer",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

