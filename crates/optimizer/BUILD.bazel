load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "skein_optimizer",
    crate_name = "skein_optimizer",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:skein_core",
        "//crates/cypher:skein_cypher",
        "//crates/expression:skein_expression",
        "//crates/plan:skein_plan",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_optimizer_tests",
    crate = ":skein_optimizer",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "planner_golden_test",
    srcs = ["tests/planner_golden.rs"],
    crate_root = "tests/planner_golden.rs",
    compile_data = [
        "tests/golden/filtered_vector_pipeline.golden",
        "tests/golden/indexed_memory_lookup.golden",
    ],
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        ":skein_optimizer",
        "//crates/cypher:skein_cypher",
        "//crates/plan:skein_plan",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Private production costing, exercised only by an explicitly selected campaign.
rust_test(
    name = "skein_optimizer_trace_cost_fuzz_tests",
    tags = ["manual"],
    args = [
        "graph::selected_trace::differential::selected_trace_cost_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_optimizer",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
