load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "query_limit_inventory_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//:__pkg__"],
)

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_executor",
    crate_name = "hawdb_executor",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/analytics:hawdb_analytics",
        "//crates/core:hawdb_core",
        "//crates/ddl:hawdb_ddl",
        "//crates/plan-cypher:hawdb_plan_cypher",
        "//crates/qos:hawdb_qos",
        "//crates/storage:hawdb_storage",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

_ENDPOINT_RESOLUTION_CASE = "mutation::staged::tests::resolved_endpoints_create_exactly_what_per_row_scans_create"

rust_test(
    name = "hawdb_executor_unit_tests",
    args = ["--skip", _ENDPOINT_RESOLUTION_CASE],
    crate = ":hawdb_executor",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# The full per-row scan oracle keeps its 300-second deadline and ordinary
# executable, but runs after competing compilation/test actions (#1462).
sh_test(
    name = "hawdb_endpoint_resolution_tests",
    timeout = "moderate",
    tags = ["exclusive"],
    srcs = ["tests/run-endpoint-resolution.sh"],
    args = [
        "$(location :hawdb_executor_unit_tests)",
        _ENDPOINT_RESOLUTION_CASE,
    ],
    data = [":hawdb_executor_unit_tests"],
)

sh_test(
    name = "endpoint_resolution_script_test",
    size = "small",
    srcs = ["tests/run-endpoint-resolution.test.sh"],
    data = ["tests/run-endpoint-resolution.sh"],
)

rust_test(
    name = "hawdb_batch_dispatch_fuzz_tests",
    size = "small",
    args = [
        "batch::tests::dispatch::batch_dispatch_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_executor",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

[
    rust_test(
        name = name,
        srcs = ["tests/morsel_oracle.rs"],
        crate_root = "tests/morsel_oracle.rs",
        size = "small",
        args = args,
        tags = tags,
        edition = "2024",
        aliases = aliases(normal_dev = True, proc_macro_dev = True),
        deps = all_crate_deps(normal_dev = True) + [
            ":hawdb_executor",
            "//crates/core:hawdb_core",
        ],
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    )
    for name, args, tags in [
        ("hawdb_morsel_oracle_tests", [], []),
        ("hawdb_morsel_oracle_fuzz_tests", ["scheduler_differential_campaign", "--exact", "--ignored", "--nocapture"], ["manual"]),
    ]
]

# The existing CI entrypoint must consume public contracts as well as unit tests.
test_suite(
    name = "hawdb_executor_tests",
    tests = [
        ":hawdb_executor_unit_tests",
        ":hawdb_endpoint_resolution_tests",
        ":endpoint_resolution_script_test",
        ":hawdb_morsel_oracle_tests",
        ":hawdb_projection_allocation_tests",
        ":hawdb_query_observer_release_tests",
    ],
)

