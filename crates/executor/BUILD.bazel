load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "skein_executor",
    crate_name = "skein_executor",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/core:skein_core",
        "//crates/plan:skein_plan",
        "//crates/storage:skein_storage",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_executor_unit_tests",
    crate = ":skein_executor",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

[
    rust_test(
        name = name,
        srcs = ["tests/morsel_oracle.rs"],
        crate_root = "tests/morsel_oracle.rs",
        args = args,
        tags = tags,
        edition = "2024",
        aliases = aliases(normal_dev = True, proc_macro_dev = True),
        deps = all_crate_deps(normal_dev = True) + [
            ":skein_executor",
            "//crates/core:skein_core",
        ],
        proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    )
    for name, args, tags in [
        ("skein_morsel_oracle_tests", [], []),
        ("skein_morsel_oracle_fuzz_tests", ["scheduler_differential_campaign", "--exact", "--ignored", "--nocapture"], ["manual"]),
    ]
]

# The existing CI entrypoint must consume public contracts as well as unit tests.
test_suite(
    name = "skein_executor_tests",
    tests = [
        ":skein_executor_unit_tests",
        ":skein_morsel_oracle_tests",
    ],
)

rust_test(
    name = "skein_query_observer_fuzz_tests",
    args = [
        "observer::query::tests::query_observer_event_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_executor",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_sort_merge_account_fuzz_tests",
    args = [
        "blocking::sort::tests::sort_merge_account_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_executor",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_spill_compaction_fuzz_tests",
    args = [
        "spill::compaction::tests::compaction_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":skein_executor",
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
