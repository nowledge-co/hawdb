load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "skein_qualification",
    crate_name = "skein_qualification",
    crate_root = "src/lib.rs",
    srcs = [
        "src/content_store_sql_corpus.rs",
        "src/lib.rs",
        "src/production_blocking.rs",
        "src/production_graph.rs",
        "src/production_morsel.rs",
        "src/production_search.rs",
        "src/production_search/lifecycle.rs",
        "src/production_vector.rs",
        "src/production_vector/lifecycle.rs",
        "src/production_vector/matrix.rs",
        "src/production_vector/oracle.rs",
        "src/production_vector/query.rs",
        "src/production_vector/tests.rs",
        "src/release_bundle.rs",
        "src/release_bundle/durability.rs",
        "src/release_bundle/graph_search.rs",
        "src/release_bundle/runtime.rs",
        "src/release_bundle/tests.rs",
        "src/release_bundle/vector.rs",
    ],
    compile_data = [
        "fixtures/nowledge_content_store/content_store_schema_v1.sql",
        "fixtures/nowledge_content_store/postgres_statement_corpus_v1.json",
    ],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//:skein",
        "//crates/query:skein_query",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "skein_content_store_contract",
    crate_name = "skein_content_store_contract",
    crate_root = "src/bin/content_store_contract.rs",
    srcs = ["src/bin/content_store_contract.rs"],
    edition = "2024",
    aliases = aliases(normal = True, proc_macro = True),
    deps = all_crate_deps(normal = True) + [":skein_qualification"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
