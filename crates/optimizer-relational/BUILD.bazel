load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
)

rust_library(
    name = "hawdb_optimizer_relational",
    crate_name = "hawdb_optimizer_relational",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True) + [
        "//crates/cascades:hawdb_cascades",
        "//crates/expression:hawdb_expression",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "hawdb_optimizer_relational_tests",
    crate = ":hawdb_optimizer_relational",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + ["//crates/core:hawdb_core"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "hawdb_optimizer_access_cost_fuzz_tests",
    size = "small",
    tags = ["manual"],
    args = [
        "relational::cost_tests::access_cost_differential_campaign",
        "--exact",
        "--ignored",
        "--nocapture",
    ],
    crate = ":hawdb_optimizer_relational",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + ["//crates/core:hawdb_core"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
