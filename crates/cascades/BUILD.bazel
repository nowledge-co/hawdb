load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "presubmit_tests",
    tests = [
        ":hawdb_cascades_tests",
        ":hawdb_cascades_integration_test",
    ],
)

rust_library(
    name = "hawdb_cascades",
    crate_name = "hawdb_cascades",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "hawdb_cascades_tests",
    crate = ":hawdb_cascades",
    edition = "2024",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "hawdb_cascades_integration_test",
    srcs = ["tests/framework_contract.rs"],
    crate_root = "tests/framework_contract.rs",
    edition = "2024",
    deps = [":hawdb_cascades"],
)
