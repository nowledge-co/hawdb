module(
    name = "skein",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.67.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_tla", version = "0.2.0")

# rules_tla 0.2.0 is not yet available from the Bazel Central Registry.
# Pin the released source revision so model checks remain reproducible.
git_override(
    module_name = "rules_tla",
    commit = "b39eb6fc672a67a7d40f1cd258d2eb3abc13f0a3",
    remote = "https://github.com/tomato-bazel/rules_tla.git",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crate_index",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crate_index")
