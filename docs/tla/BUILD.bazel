load("@rules_tla//tla:defs.bzl", "tla_check", "tla_library", "tla_test_suite")
load(":storage_models.bzl", "STORAGE_MODELS")

package(default_visibility = ["//visibility:public"])

tla_library(
    name = "governed_writer_progress",
    srcs = ["HawDBGovernedWriterProgress.tla"],
)

[
    tla_check(
        name = model + "_check",
        config = model + ".cfg",
        deps = [":governed_writer_progress"] if model == "HawDBAgedWriterProgress" else [],
        module = model + ".tla",
        tags = [
            "storage",
            "tla",
        ],
        timeout_seconds = 1800,
        tlc_args = [
            "-cleanup",
            "-workers",
            "auto",
        ] + (["-lncheck", "final"] if model == "HawDBCowPagePublication" else []),
    )
    for model in STORAGE_MODELS
]

tla_test_suite(
    name = "storage_models",
    shard_count = 1,
    tests = [":" + model + "_check" for model in STORAGE_MODELS],
)

# Materialize the same actions' evidence, including on remote-cache hits.
alias(
    name = "storage_model_evidence",
    actual = ":storage_models_evidence",
)

# Small lifecycle counterexamples are independently runnable during integration.
_LARGE_DOCUMENT_CONTROLS = [
    "CleanupRetryWitness",
    "DeliverEarly",
    "IgnoreQuota",
    "LostReplyWitness",
    "PublishEarly",
    "ReclaimPinned",
    "ReleaseOwnerEarly",
    "RollbackCommitted",
]

[
    tla_check(
        name = "HawDBLargeDocumentLifecycle" + control + "_check",
        module = "HawDBLargeDocumentLifecycle.tla",
        config = "mutants/HawDBLargeDocumentLifecycle" + control + ".cfg",
        expect = "invariant_violation",
        tags = ["manual"],
        timeout_seconds = 1800,
        tlc_args = ["-cleanup", "-workers", "auto"],
    )
    for control in _LARGE_DOCUMENT_CONTROLS
]

tla_test_suite(
    name = "large_document_controls",
    tests = [":HawDBLargeDocumentLifecycle" + control + "_check" for control in _LARGE_DOCUMENT_CONTROLS],
    tags = ["manual"],
)
