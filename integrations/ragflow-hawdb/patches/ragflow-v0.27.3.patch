+async def merge_subgraph_into_store(store, tenant_id: str, kb_id: str, subgraph: nx.Graph, callback):
+    """Merge *subgraph* in the dataset's HawDB store, in one transaction.
+
+    Returns the whole graph and the change set_graph indexes: what the merge
+    added or updated, and what the documents the store holds and no graph
+    chunk names hold, which an earlier attempt merged without writing their
+    chunks.
+    """
+    merged = await thread_pool_exec(store.merge_subgraph, subgraph)
+    graph = await thread_pool_exec(store.get_graph)
+    tidy_graph(graph, callback)
+    change = GraphChange(added_updated_nodes=set(merged.added_updated_nodes), added_updated_edges=set(merged.added_updated_edges))
+    indexed = {doc for docs in (await get_graph_chunk_sources(tenant_id, kb_id)).values() for doc in docs}
+    if merged.added_updated_nodes:
+        indexed.update(subgraph.graph["source_id"])
+    pending = [doc for doc in graph.graph["source_id"] if doc not in indexed]
+    if pending:
+        callback(msg=f"[GraphRAG] indexing {len(pending)} documents an earlier attempt merged without writing their chunks.")
+        earlier = await thread_pool_exec(store.document_change, pending)
+        change.added_updated_nodes |= earlier.added_updated_nodes
+        change.added_updated_edges |= earlier.added_updated_edges
+    return graph, change
+
