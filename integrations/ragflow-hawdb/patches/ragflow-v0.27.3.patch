+async def get_graph_chunk_sources(tenant_id, kb_id) -> dict:
+    """Map each graph chunk of *kb_id* to the document IDs it names, marked removed or not.
+
+    With a HawDB graph store, set_graph writes a graph chunk only after the
+    entity and relation chunks of its change, so the documents a graph chunk
+    names have their chunks written.
+    """
+    conds = {"fields": ["source_id"], "size": 16, "knowledge_graph_kwd": ["graph"]}
+    res = await settings.retriever.search(conds, search.index_name(tenant_id), [kb_id])
+    return {id: list(res.field[id].get("source_id") or []) for id in res.ids}
+
+
+# The HawDB stores this process has opened, so that it moves a dataset's graph
+# from the document store into its HawDB store at most once.
+_HAWDB_STORES_READY = set()
+
+
+async def hawdb_graph_store(tenant_id, kb_id, exclude_rebuild=None):
+    """Return the HawDB store of the graph of *kb_id*, or None if the document store keeps the graph.
+
+    The first time a process opens a store that holds no graph, it imports the
+    graph the document store keeps for the dataset, if there is one. A store
+    whose import stopped partway holds no graph either: importing again starts
+    the import over, and importing an empty graph discards it.
+    """
+    store = graph_store_for(tenant_id, kb_id)
+    if store is None or store.path in _HAWDB_STORES_READY:
+        return store
+    if not await thread_pool_exec(store.holds_graph):
+        graph = await _get_graph_from_doc_store(tenant_id, kb_id, exclude_rebuild)
+        try:
+            await thread_pool_exec(store.import_graph, nx.Graph() if graph is None else graph)
+        except ValueError:
+            # Another process imported the graph or merged a document first.
+            if not await thread_pool_exec(store.holds_graph):
+                raise
+        else:
+            if graph is not None:
+                logging.info(f"Imported the knowledge graph of dataset {kb_id} into the HawDB store at {store.path}")
+    _HAWDB_STORES_READY.add(store.path)
+    return store
+
+
 async def get_graph(tenant_id, kb_id, exclude_rebuild=None):
     """Load the knowledge-graph for *kb_id* from the document store, rebuilding if marked removed."""
+    store = await hawdb_graph_store(tenant_id, kb_id, exclude_rebuild)
+    if store is not None:
+        return await thread_pool_exec(store.get_graph)
+    return await _get_graph_from_doc_store(tenant_id, kb_id, exclude_rebuild)
+
