+"""Keep each dataset's GraphRAG graph in an embedded HawDB database.
+
+Set ``hawdb_graph.path`` in conf/service_conf.yaml, and every dataset keeps its
+graph in a HawDB database at ``<path>/<tenant id>/<dataset id>``:
+
+    hawdb_graph:
+      path: /ragflow/hawdb_graph
+      max_paths_per_entity: 1000
+      busy_timeout: 60
+
+Every RAGFlow process that builds, retrieves or deletes graphs must see the
+same directory, and needs the ``ragflow-hawdb`` package. Without
+``hawdb_graph.path``, RAGFlow keeps the graph in its document engine.
+"""
+
+from common.config_utils import get_base_config
+
+# The graph attribute that marks a graph chunk the HawDB path wrote, which holds
+# only what the knowledge-graph view shows (ragflow_hawdb.ragflow.VIEW_MARKER).
+_VIEW_MARKER = ("graph_store", "hawdb")
+
+
+def graph_store_for(tenant_id, kb_id):
+    """Return the HawDB store of the dataset's graph, or None if none is configured."""
+    config = get_base_config("hawdb_graph", {}) or {}
+    if not config.get("path"):
+        return None
+    from ragflow_hawdb.ragflow import store_for
+
+    return store_for(
+        config["path"],
+        tenant_id,
+        kb_id,
+        max_paths=int(config.get("max_paths_per_entity", 1000)),
+        busy_timeout=float(config.get("busy_timeout", 60)),
+    )
+
+
+def graph_view(graph):
+    """Return the part of *graph* the knowledge-graph view shows, marked as a view."""
+    from ragflow_hawdb.ragflow import view_graph
+
+    return view_graph(graph)
+
+
+def is_graph_view(graph):
+    """Return True if *graph* came from a graph chunk the HawDB path wrote."""
+    return graph.graph.get(_VIEW_MARKER[0]) == _VIEW_MARKER[1]
