load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@python_test_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

rust_shared_library(
    name = "_hawdb",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["abi3"],
    crate_name = "_hawdb",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Python supplies its symbols when importing an extension on macOS.
    rustc_flags = select({
        "@platforms//os:macos": [
            # Rust 1.97.1 stripping misaligns Mach-O's LINKEDIT string pool.
            "-Cstrip=none",
            "-C",
            "link-arg=-undefined",
            "-C",
            "link-arg=dynamic_lookup",
            "-C",
            "link-arg=-Wl,-no_fixup_chains",
        ],
        "//conditions:default": [],
    }),
    version = "0.6.0",
    deps = [
        "//:hawdb",
        "@python_crates//:pyo3",
    ],
)

copy_file(
    name = "extension_unix",
    src = ":_hawdb",
    out = "python/hawdb/_hawdb.so",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

copy_file(
    name = "extension_windows",
    src = ":_hawdb",
    out = "python/hawdb/_hawdb.pyd",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

alias(
    name = "extension",
    actual = select({
        "@platforms//os:windows": ":extension_windows",
        "//conditions:default": ":extension_unix",
    }),
)

py_library(
    name = "hawdb",
    srcs = glob(["python/hawdb/*.py"]),
    data = [":extension"] + glob(["python/hawdb/*.pyi", "python/hawdb/py.typed"]),
    imports = ["python"],
)

_RETAINED_TEST_SRCS = [
    "tests/test_arrow.py",
    "tests/test_arrow_consumer.py",
    "tests/test_retained.py",
]

py_test(
    name = "hawdb_python_row_tests",
    size = "small",
    srcs = glob(["tests/*.py"], exclude = _RETAINED_TEST_SRCS),
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":hawdb",
        requirement("pytest"),
    ],
)

py_test(
    name = "hawdb_python_retained_tests",
    size = "small",
    srcs = [
        "tests/conftest.py",
        "tests/pytest_main.py",
    ] + _RETAINED_TEST_SRCS,
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":hawdb",
        requirement("pytest"),
    ],
)

# Preserve the full default suite while each independent group keeps the same
# small-test deadline and per-case durable/in-memory database isolation.
test_suite(
    name = "hawdb_python_tests",
    tests = [
        ":hawdb_python_row_tests",
        ":hawdb_python_retained_tests",
    ],
)

# The default suite above runs without Pydantic, so it also proves the extra is
# optional; this one installs the extra and runs its coverage.
py_test(
    name = "hawdb_python_pydantic_tests",
    size = "small",
    srcs = [
        "tests/conftest.py",
        "tests/pytest_main.py",
    ] + glob(["tests/test_pydantic*.py"]),
    legacy_create_init = False,
    main = "tests/pytest_main.py",
    deps = [
        ":hawdb",
        requirement("pydantic"),
        requirement("pytest"),
    ],
)

compile_pip_requirements(
    name = "requirements",
    extra_args = ["--generate-hashes"],
    python_version = "3.11",
    requirements_in = "requirements.in",
    requirements_txt = "requirements.txt",
)

# Local profiling extension: loaded explicitly by the benchmark, never default.
rust_shared_library(
    name = "_hawdb_boundary_profile",
    srcs = glob(["src/**/*.rs"]) + ["//bindings/benchmarks:native_alloc.rs", "//bindings/benchmarks:native_profile.rs"],
    crate_features = ["abi3", "boundary-profiling"],
    crate_name = "_hawdb_boundary_profile",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Python supplies its symbols when importing an extension on macOS.
    rustc_flags = select({
        "@platforms//os:macos": [
            # Rust 1.97.1 stripping misaligns Mach-O's LINKEDIT string pool.
            "-Cstrip=none",
            "-C",
            "link-arg=-undefined",
            "-C",
            "link-arg=dynamic_lookup",
            "-C",
            "link-arg=-Wl,-no_fixup_chains",
        ],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    version = "0.6.0",
    deps = [
        "//:hawdb",
        "@python_crates//:pyo3",
    ],
)
