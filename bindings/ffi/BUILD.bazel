load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_static_library")

package(default_visibility = ["//visibility:public"])

exports_files(["include/hawdb_ffi.h"])

_FFI_DEPS = [
    "//:hawdb",
    "@crate_index//:serde_json",
    "@ffi_crates//:base64",
]

rust_shared_library(
    name = "hawdb_ffi",
    srcs = ["src/lib.rs"],
    crate_name = "hawdb_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    # The pinned Rust stripping tool produces an invalid Mach-O LINKEDIT
    # string pool rejected by macOS 27. Keep the optimized library loadable.
    rustc_flags = select({
        "@platforms//os:macos": ["-Cstrip=none"],
        "//conditions:default": [],
    }),
    version = "0.6.0",
    deps = _FFI_DEPS,
)

rust_static_library(
    name = "hawdb_ffi_static",
    srcs = ["src/lib.rs"],
    crate_name = "hawdb_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.6.0",
    deps = _FFI_DEPS,
)

# Local profiling only; not a replacement library or a default/CI dependency.
rust_shared_library(
    name = "hawdb_ffi_boundary_profile",
    srcs = ["src/lib.rs", "//bindings/benchmarks:native_alloc.rs", "//bindings/benchmarks:native_profile.rs"],
    crate_name = "hawdb_ffi_boundary_profile",
    crate_root = "src/lib.rs",
    crate_features = ["boundary-profiling"],
    edition = "2024",
    rustc_flags = select({
        "@platforms//os:macos": ["-Cstrip=none"],
        "//conditions:default": [],
    }),
    version = "0.6.0",
    deps = _FFI_DEPS,
    tags = ["manual"],
)
