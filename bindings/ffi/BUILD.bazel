load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_static_library", "rust_test")

load(":runtime_library.bzl", "rust_runtime_library")

package(default_visibility = ["//visibility:public"])

exports_files(["include/hawdb_ffi.h"])

_FFI_DEPS = [
    "//:hawdb",
    "@crate_index//:serde_json",
    "@ffi_crates//:base64",
]

rust_test(
    name = "hawdb_ffi_tests",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "hawdb_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _FFI_DEPS,
)

rust_shared_library(
    name = "hawdb_ffi",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "hawdb_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.21.0",
    deps = _FFI_DEPS,
)

rust_runtime_library(
    name = "hawdb_ffi_runtime",
    library = ":hawdb_ffi",
)

rust_static_library(
    name = "hawdb_ffi_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "hawdb_ffi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.21.0",
    deps = _FFI_DEPS,
)

# Local profiling only; not a replacement library or a default/CI dependency.
rust_shared_library(
    name = "hawdb_ffi_boundary_profile",
    srcs = glob(["src/**/*.rs"]) + ["//bindings/benchmarks:native_alloc.rs", "//bindings/benchmarks:native_profile.rs"],
    crate_name = "hawdb_ffi_boundary_profile",
    crate_root = "src/lib.rs",
    crate_features = ["boundary-profiling"],
    edition = "2024",
    version = "0.21.0",
    deps = _FFI_DEPS,
    tags = ["manual"],
)
