load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

_CARGO_WORKSPACE_PACKAGES = [
    "crates/analytics",
    "crates/cgroup",
    "crates/core",
    "crates/cypher",
    "crates/ddl",
    "crates/evidence",
    "crates/executor",
    "crates/expression",
    "crates/fuzz",
    "crates/integrity",
    "crates/optimizer",
    "crates/plan",
    "crates/plan-cache",
    "crates/qos",
    "crates/qualification",
    "crates/query",
    "crates/readiness",
    "crates/route-ownership",
    "crates/runtime-tokio",
    "crates/sql",
    "crates/sql-syntax",
    "crates/storage",
    "crates/telemetry",
    "crates/vector-projection",
]

sh_test(
    name = "cargo_bazel_package_parity_test",
    size = "small",
    srcs = ["scripts/check-cargo-bazel-package-parity.sh"],
    data = [
        "BUILD.bazel",
        "Cargo.toml",
    ] + [
        "//%s:BUILD.bazel" % package
        for package in _CARGO_WORKSPACE_PACKAGES
    ] + [
        "//%s:Cargo.toml" % package
        for package in _CARGO_WORKSPACE_PACKAGES
    ],
)

sh_test(
    name = "cargo_bazel_package_parity_script_test",
    size = "small",
    srcs = ["scripts/check-cargo-bazel-package-parity.test.sh"],
    data = ["scripts/check-cargo-bazel-package-parity.sh"],
)

_SKEIN_SRCS = glob(
    ["src/**/*.rs"],
    exclude = [
        "src/bin/**",
        "src/main.rs",
    ],
)

_SKEIN_BASE_DEPS = all_crate_deps(normal = True) + [
    "//crates/analytics:skein_analytics",
    "//crates/core:skein_core",
    "//crates/cypher:skein_cypher",
    "//crates/ddl:skein_ddl",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/expression:skein_expression",
    "//crates/integrity:skein_integrity",
    "//crates/optimizer:skein_optimizer",
    "//crates/plan:skein_plan",
    "//crates/plan-cache:skein_plan_cache",
    "//crates/qos:skein_qos",
    "//crates/query:skein_query",
    "//crates/readiness:skein_readiness",
    "//crates/route-ownership:skein_route_ownership",
    "//crates/sql:skein_sql",
    "//crates/storage:skein_storage",
    "//crates/telemetry:skein_telemetry",
]

rust_library(
    name = "skein",
    crate_name = "skein",
    crate_root = "src/lib.rs",
    crate_features = [
        "background-maintenance",
        "full-text-search",
        "graph-analytics",
        "tokio-runtime",
        "vector-search",
    ],
    srcs = _SKEIN_SRCS,
    edition = "2024",
    aliases = aliases(),
    deps = _SKEIN_BASE_DEPS + [
        "//crates/runtime-tokio:skein_runtime_tokio",
        "//crates/vector-projection:skein_vector_projection",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Matches `skein = { default-features = false }` for dependency-boundary checks.
rust_library(
    name = "skein_minimal",
    crate_name = "skein",
    crate_root = "src/lib.rs",
    srcs = _SKEIN_SRCS,
    edition = "2024",
    aliases = aliases(),
    deps = _SKEIN_BASE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "skein_unit_tests",
    crate = ":skein",
    crate_features = [
        "background-maintenance",
        "full-text-search",
        "graph-analytics",
        "tokio-runtime",
        "vector-search",
    ],
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Matches `cargo test -p skein --features acl --lib` for the storage crash
# recovery qualification. Keep this target opt-in because it recompiles the
# root inline tests under a distinct feature set.
rust_test(
    name = "skein_storage_crash_recovery_tests",
    size = "large",
    crate = ":skein",
    crate_features = [
        "acl",
        "background-maintenance",
        "full-text-search",
        "graph-analytics",
        "vector-search",
    ],
    edition = "2024",
    tags = ["manual"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_cli_tests",
    crate_root = "src/main.rs",
    crate_features = [
        "background-maintenance",
        "full-text-search",
        "graph-analytics",
        "tokio-runtime",
        "vector-search",
    ],
    srcs = ["src/main.rs"] + glob(["src/cli/**/*.rs"]),
    edition = "2024",
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":skein",
        "//crates/integrity:skein_integrity",
        "//crates/storage:skein_storage",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "skein_shadow_self_tests",
    crate_root = "src/bin/skein-shadow-self.rs",
    crate_features = [
        "background-maintenance",
        "full-text-search",
        "graph-analytics",
        "tokio-runtime",
        "vector-search",
    ],
    srcs = ["src/bin/skein-shadow-self.rs"],
    edition = "2024",
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal = True, normal_dev = True) + [":skein"],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)
