skein_benchmark_binaries(_SKEIN_DEFAULT_FEATURES)

_SKEIN_LINUX_CI_SMOKE_ARGS = [
    "$(location :skein_cli)",
    "$(location :skein_shadow_self)",
    "$(location :nowledge_previous_wrapper_shadow_adapter)",
    "$(location //crates/fuzz:skein_append_fuzz)",
    "$(location //crates/fuzz:skein_storage_fuzz)",
    "$(location //crates/fuzz:skein_optimizer_fuzz)",
] + [
    "$(location %s)" % target
    for target in SKEIN_BENCHMARK_TARGETS
]

_SKEIN_LINUX_CI_SMOKE_DATA = [
    ":nowledge_previous_wrapper_shadow_adapter",
    ":skein_cli",
    ":skein_shadow_self",
    "//crates/fuzz:skein_append_fuzz",
    "//crates/fuzz:skein_optimizer_fuzz",
    "//crates/fuzz:skein_storage_fuzz",
] + SKEIN_BENCHMARK_TARGETS

# Optimizer benchmarks emit resource-sensitive evidence. Give each group an
# independent deadline, but preserve the original serial execution semantics.
[
    sh_test(
        name = "skein_linux_ci_%s_smoke_test" % smoke,
        size = size,
        srcs = ["scripts/check-linux-ci-smokes.sh"],
        args = [smoke] + _SKEIN_LINUX_CI_SMOKE_ARGS,
        data = _SKEIN_LINUX_CI_SMOKE_DATA,
        tags = ["manual"] + extra_tags,
    )
    for smoke, size, extra_tags in [
        ("fuzz", "enormous", []),
        ("optimizer_summary", "medium", ["exclusive"]),
        ("optimizer_group_1", "large", ["exclusive"]),
        ("optimizer_group_2", "medium", ["exclusive"]),
        ("optimizer_group_3", "medium", ["exclusive"]),
        ("fixture_contract", "medium", []),
        ("storage_recovery", "medium", []),
        ("background_maintenance", "medium", []),
        ("previous_wrapper_adapter", "medium", []),
        ("migration_gate", "large", []),
        ("migration_gate_blocked", "medium", []),
    ]
]

# Fuzz smoke remains available as a standalone local target, but is excluded
# from the default CI smoke suite.
test_suite(
    name = "skein_linux_ci_smoke_tests",
    tests = [
        ":skein_linux_ci_%s_smoke_test" % smoke
        for smoke in [
            "optimizer_summary",
            "optimizer_group_1",
            "optimizer_group_2",
            "optimizer_group_3",
            "fixture_contract",
            "storage_recovery",
            "background_maintenance",
            "previous_wrapper_adapter",
            "migration_gate",
            "migration_gate_blocked",
        ]
    ],
    tags = ["manual"],
)
