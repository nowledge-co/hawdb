        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = _SKEIN_BASE_DEPS + _SKEIN_VECTOR_DEPS + all_crate_deps(normal_dev = True) + [
        "//crates/runtime-tokio:skein_runtime_tokio",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
