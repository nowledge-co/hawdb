_SKEIN_SRCS = glob(
    ["src/**/*.rs"],
    exclude = [
        "src/bin/**",
        "src/main.rs",
    ],
)

_SKEIN_BASE_DEPS = [
    "@crate_index//:chrono",
    "@crate_index//:jieba-rs",
    "@crate_index//:serde",
    "@crate_index//:serde_json",
    "@crate_index//:unicode-width",
    "@crate_index//:zstd",
    "//crates/analytics:skein_analytics",
    "//crates/core:skein_core",
    "//crates/cypher:skein_cypher",
    "//crates/ddl:skein_ddl",
    "//crates/evidence:skein_evidence",
    "//crates/executor:skein_executor",
    "//crates/expression:skein_expression",
    "//crates/integrity:skein_integrity",
    "//crates/optimizer:skein_optimizer",
    "//crates/plan:skein_plan",
    "//crates/plan-cache:skein_plan_cache",
    "//crates/qos:skein_qos",
    "//crates/query:skein_query",
    "//crates/readiness:skein_readiness",
    "//crates/route-ownership:skein_route_ownership",
    "//crates/sql:skein_sql",
    "//crates/storage:skein_storage",
    "//crates/telemetry:skein_telemetry",
]

# crate_universe exposes optional normal dependencies to every Bazel target.
# Keep the native vector dependency owned by targets that enable vector-search.
_SKEIN_VECTOR_DEPS = [
    "@crate_index//:simsimd",
    "//crates/vector-projection:skein_vector_projection",
]

_SKEIN_DEFAULT_FEATURES = [
    "background-maintenance",
    "full-text-search",
    "graph-analytics",
    "tokio-runtime",
    "vector-search",
]

rust_library(
    name = "skein",
    crate_name = "skein",
    crate_root = "src/lib.rs",
    crate_features = _SKEIN_DEFAULT_FEATURES,
    srcs = _SKEIN_SRCS,
    edition = "2024",
    aliases = aliases(),
    deps = _SKEIN_BASE_DEPS + _SKEIN_VECTOR_DEPS + [
        "//crates/runtime-tokio:skein_runtime_tokio",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

# Matches `skein = { default-features = false }` for dependency-boundary checks.
rust_library(
    name = "skein_minimal",
    crate_name = "skein",
    crate_root = "src/lib.rs",
    srcs = _SKEIN_SRCS,
    edition = "2024",
    aliases = aliases(),
    deps = _SKEIN_BASE_DEPS,
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

_SKEIN_STORAGE_CRASH_MATRIX_TEST = "api::tests::storage_recovery::subprocess_crash_matrix_recovers_whole_batches_and_artifact_generations"

rust_test(
    name = "skein_unit_fast_tests",
    # The remaining root tests can still exceed the 300-second default under
    # Prow contention even after the crash matrix is isolated.
    size = "large",
    args = [
        "--skip",
        _SKEIN_STORAGE_CRASH_MATRIX_TEST,
    ],
    crate = ":skein",
    crate_features = _SKEIN_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "skein_unit_storage_crash_matrix_tests",
    size = "large",
    args = [
        _SKEIN_STORAGE_CRASH_MATRIX_TEST,
        "--exact",
    ],
    crate = ":skein",
    crate_features = _SKEIN_DEFAULT_FEATURES,
    edition = "2024",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

test_suite(
    name = "skein_unit_tests",
    tests = [
        ":skein_unit_fast_tests",
        ":skein_unit_storage_crash_matrix_tests",
    ],
)

rust_test(
    name = "skein_system_sql_loom_tests",
    args = ["api::system_sql::loom_tests"],
    crate_features = [
        "background-maintenance",
